{
  "name": "edu-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal cross-platform desktop learning workspace",
  "desktopName": "edu-harness.desktop",
  "author": "edu-harness contributors",
  "type": "module",
  "main": "out/main/index.js",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev --watch",
    "kill-dev": "node scripts/kill-dev.ts",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:desktop": "npm run build && playwright test",
    "build": "npm run typecheck && electron-vite build",
    "check": "npm run lint && npm run test && npm run build",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
